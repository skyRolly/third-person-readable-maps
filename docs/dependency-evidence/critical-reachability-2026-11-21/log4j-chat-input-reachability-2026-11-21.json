  "technical_dispositions": [
    {
      "advisory_id": "GHSA-jfh8-c2jp-5v3q",
      "disposition": "Further investigation",
      "reachability": "The attacker-controlled chat-to-logger path is present in exact Minecraft 1.14.4 and 1.17.1 clients. The 1.17.1 Log4j 2.14.1 parameterized [CHAT] probe invokes the synthetic JNDI context twice with the embedded fallback XML and zero times with the external launcher XML. For 1.14.4 Log4j 2.8.1, Patchy 1.3.9 stubs JndiLookup in manifest order; reversing that order makes the fallback probe invoke the local context twice.",
      "reason_unresolved": "The version metadata specifies -Dlog4j.configurationFile=${path} and the external XML, but production JVM arguments and loaded classpaths were not captured for each supported launcher. A custom launcher, altered classpath, or logging override changes the tested mitigation assumptions. No network lookup or game exploit was attempted.",
      "release_blocking": true,
      "risk_accepted": false
    },
    {
      "advisory_id": "GHSA-7rjr-3q55-vv33",
      "disposition": "Further investigation",
      "reachability": "The same remote chat text reaches the message logger. The inspected Minecraft chat path does not itself write that value to Log4j ThreadContext/MDC, and the official XML does not configure context lookup patterns. The separate synthetic MDC/layout probe remains evidence that alternate layouts can activate the advisory condition.",
      "reason_unresolved": "No full process-level search ruled out mod/plugin ThreadContext population, alternate layouts, or launcher configuration changes.",
      "release_blocking": true,
      "risk_accepted": false
    },
    {
      "advisory_id": "GHSA-fxph-q3j8-mv87",
      "disposition": "Further investigation",
      "reachability": "The exact default and embedded Minecraft logging XML contain no TCP/UDP socket-server appender. Existing exact-client literal scans found no direct TcpSocketServer/UdpSocketServer reference.",
      "reason_unresolved": "Custom launcher configuration, third-party appenders, reflective paths, and arbitrary installed mods were not exhaustively examined.",
      "release_blocking": true,
      "risk_accepted": false
    }
  ],
