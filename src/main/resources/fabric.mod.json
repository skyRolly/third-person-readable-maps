    "issues": "https://github.com/skyRolly/third-person-readable-maps/issues"
  },
  "license": "MIT",
  "environment": "client",
  "mixins": ["thirdpersonreadablemaps.mixins.json"],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": ["1.19.4", "1.20", "1.20.1", "1.20.2", "1.20.3", "1.20.4"],
    "java": ">=17"
  }
}
