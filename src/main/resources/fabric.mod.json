{
  "schemaVersion": 1,
  "id": "thirdpersonreadablemaps",
  "version": "${version}",
  "name": "Third Person Readable Maps",
  "description": "Renders filled map contents on maps carried by third-person players.",
  "authors": ["skyRolly"],
  "contact": {
    "sources": "https://github.com/skyRolly/third-person-readable-maps",
    "issues": "https://github.com/skyRolly/third-person-readable-maps/issues"
  },
  "license": "MIT",
  "environment": "client",
  "mixins": ["thirdpersonreadablemaps.mixins.json"],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": ["1.17", "1.17.1", "1.18", "1.18.1", "1.18.2", "1.19", "1.19.1", "1.19.2"],
    "java": ">=16"
  }
}
